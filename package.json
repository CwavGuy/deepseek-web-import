{
  "name": "deepseek-web-import",
  "version": "0.2.3",
  "description": "Import chat.deepseek.com conversations into DeepSeek Harness as resumable sessions, from a settings-page UI. Fork with Session format v0-v4 support.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CwavGuy/deepseek-web-import.git"
  },
  "homepage": "https://github.com/CwavGuy/deepseek-web-import#readme",
  "bugs": {
    "url": "https://github.com/CwavGuy/deepseek-web-import/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/events.test.mjs test/host-routes.test.mjs test/transport.test.mjs",
    "test:serve": "echo 'run test/compat.mjs and test/live-import.mjs from a DSH install directory (see docs/COMPATIBILITY.md)'"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "web-ui",
    "import",
    "conversations",
    "session"
  ],
  "license": "MIT"
}
